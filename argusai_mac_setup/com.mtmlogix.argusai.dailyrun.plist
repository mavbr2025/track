<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

    <!-- Unique identifier for this LaunchAgent -->
    <key>Label</key>
    <string>com.mtmlogix.argusai.dailyrun</string>

    <!-- Path to the shell script to run -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/mario/argusai_daily_run.sh</string>
    </array>

    <!-- Schedule: 5:00 AM every day -->
    <!-- Note: LaunchAgents use LOCAL time. If your Mac is set to EST this is correct. -->
    <!-- If your Mac is on a different timezone, adjust Hour accordingly: -->
    <!--   CST (UTC-6) = Hour 5 | MST (UTC-7) = Hour 5 | PST (UTC-8) = Hour 5 -->
    <!--   (All 5 AM local time — Mac uses local timezone) -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>5</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- Log output to file for debugging -->
    <key>StandardOutPath</key>
    <string>/Users/mario/argusai_launchagent.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/mario/argusai_launchagent_error.log</string>

    <!-- Run even if the trigger time was missed (e.g. Mac was asleep) -->
    <key>RunAtLoad</key>
    <false/>

</dict>
</plist>
