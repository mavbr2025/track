# ClickUp API
CLICKUP_API_TOKEN=your_token
CLICKUP_OAUTH_ACCESS_TOKEN=
CLICKUP_OAUTH_CLIENT_ID=
CLICKUP_OAUTH_CLIENT_SECRET=
CLICKUP_OAUTH_REDIRECT_URI=http://localhost:8080/callback
CLICKUP_LIST_ID=123456
# Optional: comma-separated list of list IDs to scan across your system
CLICKUP_LIST_IDS=
# Optional: team/workspace ID for automatic space discovery
CLICKUP_TEAM_ID=
# Optional: comma-separated space IDs. Lists in these spaces will be discovered automatically
CLICKUP_SPACE_IDS=
# Optional: comma-separated folder IDs. Lists in these folders will be included
CLICKUP_FOLDER_IDS=
# Optional: when true, discover lists from CLICKUP_SPACE_IDS
CLICKUP_DISCOVER_LISTS_FROM_SPACES=true
CLICKUP_DISCOVER_LISTS_FROM_TEAM=false

# Custom field IDs from ClickUp (UUID-like IDs)
CLICKUP_CF_CONTAINER_NO=container_field_id
CLICKUP_CF_BOOKING_NO=booking_field_id
CLICKUP_CF_SHIPPING_LINE=shipping_line_field_id

# Optional: if you want to save carrier status into a custom field
CLICKUP_CF_SHIPMENT_STATUS=

# Optional: if you have a custom field for last checked timestamp
CLICKUP_CF_STATUS_LAST_CHECKED=

# Optional: text custom field used to store the last Track-and-Trace snapshot hash.
# Recommended if you only want ClickUp comments/updates when carrier data actually changes.
CLICKUP_CF_TRACK_TRACE_SNAPSHOT=

# Optional task filters when reading list tasks
CLICKUP_INCLUDE_CLOSED=false
CLICKUP_INCLUDE_ARCHIVED=false

# Accounts payable / invoice lookup in ClickUp
# Required for AP lookup: set one or more AP list IDs
CLICKUP_AP_LIST_ID=
CLICKUP_AP_LIST_IDS=
CLICKUP_AP_INCLUDE_CLOSED=false
CLICKUP_AP_INCLUDE_ARCHIVED=false
# When true, use the task name as invoice number when no dedicated field is configured
CLICKUP_AP_TASK_NAME_AS_INVOICE_NUMBER=true
# Optional AP custom field selectors (field ID or exact field name)
CLICKUP_AP_CF_INVOICE_NUMBER=
CLICKUP_AP_CF_VENDOR=
CLICKUP_AP_CF_AMOUNT=
CLICKUP_AP_CF_CURRENCY=
CLICKUP_AP_CF_STATUS=
CLICKUP_AP_CF_DUE_DATE=

# Optional: use ClickUp task status instead of custom field.
# Must match an existing status name in your ClickUp workflow.
CLICKUP_USE_TASK_STATUS=true
CLICKUP_TASK_STATUS_ON_UPDATE=In Progress

# Optional
CLICKUP_STATUS_COMMENT_PREFIX="Shipment update"
SHIPMENT_API_HOST=127.0.0.1
SHIPMENT_API_PORT=8000
# Strongly recommended before exposing the API publicly.
# Supported on protected endpoints via:
# - Authorization: Bearer <token>
# - X-Trigger-Token: <token>
# - ?token=<token>
SHIPMENT_API_TRIGGER_TOKEN=
# ETA-only mode (recommended to minimize tracked fields in sync output/comments)
SHIPMENT_ETA_ONLY=true
# Number of moves to include in ClickUp comments (0 = all available events)
SHIPMENT_RECENT_MOVES_LIMIT=0
# Optional: only process these normalized line names (comma-separated), e.g. one,maersk
SHIPMENT_ALLOWED_LINES=
# Optional: always skip these normalized line names (comma-separated), e.g. msc,hapag lloyd
SHIPMENT_EXCLUDED_LINES=
# When true, lines without a registered adapter are skipped before sync calls
SHIPMENT_SKIP_UNSUPPORTED_LINES=true
# When true, run carrier DNS/HTTPS preflight and skip failing lines upfront
SHIPMENT_PREFLIGHT_ENABLED=true
# Timeout (seconds) for each preflight HTTPS probe
SHIPMENT_PREFLIGHT_TIMEOUT_SECONDS=8
# Skip tasks synced recently using CLICKUP_CF_STATUS_LAST_CHECKED (0 disables)
SHIPMENT_MIN_SYNC_INTERVAL_HOURS=0
# When true, post a small "No change" comment when the carrier snapshot matches the previous run.
SHIPMENT_COMMENT_ON_NO_CHANGE=false

# Maersk adapter config
# Option A (website template): https://www.maersk.com/tracking/{reference}
MAERSK_TRACKING_URL_TEMPLATE=

# Option B (API endpoint): https://your-maersk-endpoint/tracking
MAERSK_TRACKING_API_URL=
MAERSK_API_KEY=
MAERSK_API_KEY_HEADER=X-API-Key
MAERSK_REF_PARAM=reference
MAERSK_TYPE_PARAM=referenceType
MAERSK_API_MODE=events
MAERSK_CONSUMER_KEY=
MAERSK_BEARER_TOKEN=
MAERSK_OAUTH_TOKEN_URL=https://api.maersk.com/oauth2/access_token
MAERSK_OAUTH_CLIENT_ID=
MAERSK_OAUTH_CLIENT_SECRET=
MAERSK_OAUTH_SCOPE=
MAERSK_API_VERSION=1
# Page size when pulling Maersk events.
MAERSK_EVENTS_LIMIT=100
# Pull all available Maersk event pages.
MAERSK_FETCH_ALL_EVENTS=true
# Fallback to Maersk public tracking page when events API returns errors (404/400/etc)
MAERSK_WEB_FALLBACK_ON_API_ERROR=true
MAERSK_TIMEOUT_SECONDS=60
MAERSK_MAX_RETRIES=2
MAERSK_RETRY_DELAY_SECONDS=2

# ONE adapter config
# Option A (website): https://ecomm.one-line.com/one-ecom/manage-shipment/cargo-tracking
ONE_TRACKING_URL_TEMPLATE=

# Option B (API): https://your-one-endpoint/tracking
ONE_TRACKING_API_URL=
ONE_API_KEY=
ONE_API_KEY_HEADER=X-API-Key
ONE_REF_PARAM=trakNoParam
ONE_TYPE_PARAM=trakNoTpCdParam
ONE_BOOKING_TYPE_CODE=B
ONE_CONTAINER_TYPE_CODE=C
# Preferred ONE source for arrival dates (ETA): official ONE eCommerce EDH APIs
ONE_USE_EDH_API=true
ONE_EDH_BASE_URL=https://ecomm.one-line.com/api/v1/edh
ONE_TIMEOUT_SECONDS=60
ONE_MAX_RETRIES=2
ONE_RETRY_DELAY_SECONDS=2

# ONE booking API config
# ONE eCommerce booking flows discovered in the public app:
# - /booking/booking-request
# - /booking/booking-confirm-information
# The protected backend endpoints vary by account/region, so set the API paths below
# to the ones provisioned for your ONE eCommerce credentials.
ONE_BOOKING_API_BASE_URL=https://ecomm.one-line.com/api
ONE_BOOKING_PAGE_BASE_URL=https://ecomm.one-line.com/one-ecom
ONE_BOOKING_REQUEST_PAGE_PATH=/booking/booking-request
ONE_BOOKING_CONFIRMATION_PAGE_PATH=/booking/booking-confirm-information
ONE_BOOKING_REQUEST_ENDPOINT=
ONE_BOOKING_CONFIRMATION_ENDPOINT=
ONE_BOOKING_API_KEY=
ONE_BOOKING_API_KEY_HEADER=X-API-Key
ONE_BOOKING_BEARER_TOKEN=
ONE_BOOKING_CONFIRMATION_REF_PARAM=reference
ONE_BOOKING_CONFIRMATION_TYPE_PARAM=referenceType
ONE_BOOKING_TIMEOUT_SECONDS=60
ONE_BOOKING_MAX_RETRIES=2
ONE_BOOKING_RETRY_DELAY_SECONDS=2

# COSCO adapter config
# Mode: cop (official HMAC API), legacy (public tracking pages), auto (cop if keys exist, else legacy)
COSCO_MODE=cop

# Official COSCO Open API (COP) mode
# Repo/spec reference: https://github.com/cop-cos/COP
# Test/UAT base URL:
COSCO_COP_BASE_URL=https://api-pp.lines.coscoshipping.com
# Production base URL:
# COSCO_COP_BASE_URL=https://api.lines.coscoshipping.com
COSCO_COP_SERVICE_PREFIX=/service
COSCO_COP_API_KEY=
COSCO_COP_SECRET_KEY=
# numberType query values for /service/info/tracking/{reference}?numberType=...
COSCO_COP_BL_NUMBER_TYPE=bl
COSCO_COP_BOOKING_NUMBER_TYPE=bkg
COSCO_COP_CONTAINER_NUMBER_TYPE=cntr
# Some COP docs list X-Coscon-Hmac as mandatory.
COSCO_COP_INCLUDE_X_HMAC=true

# Legacy public tracking fallback (usually anti-bot protected)
COSCO_TRACKING_URL_TEMPLATE=https://elines.coscoshipping.com/ebusiness/cargoTracking?trackingType={type}&number={reference}
COSCO_TRACKING_API_BASE_URL=https://elines.coscoshipping.com/ebtracking
COSCO_USE_API=true
# Legacy trackingType values
COSCO_BL_TYPE_CODE=BILLOFLADING
COSCO_BOOKING_TYPE_CODE=BOOKING
COSCO_CONTAINER_TYPE_CODE=CONTAINER
COSCO_TIMEOUT_SECONDS=45
COSCO_MAX_RETRIES=2
COSCO_RETRY_DELAY_SECONDS=2

# CMA-CGM adapter config
# Typical public tracking detail page:
# https://www.cma-cgm.com/ebusiness/tracking/detail/{reference}
CMA_CGM_TRACKING_URL_TEMPLATE=https://www.cma-cgm.com/ebusiness/tracking/detail/{reference}
# Optional API endpoint (if provided by CMA-CGM account/support)
CMA_CGM_TRACKING_API_URL=
# Optional alternative API config (base + method)
CMA_CGM_API_BASE_URL=
CMA_CGM_API_METHOD=searchMoveOnCommercialCycle
CMA_CGM_API_METHOD_PATH=
CMA_CGM_API_KEY=
CMA_CGM_API_KEY_HEADER=keyId
# Reference query params (leave blank if API method uses only path/body)
CMA_CGM_REF_PARAM=
CMA_CGM_CONTAINER_REF_PARAM=equipmentReference
CMA_CGM_BOOKING_REF_PARAM=carrierBookingReference
CMA_CGM_TYPE_PARAM=
CMA_CGM_INCLUDE_TYPE_PARAM=false
CMA_CGM_BOOKING_TYPE_CODE=booking
CMA_CGM_CONTAINER_TYPE_CODE=container
CMA_CGM_TIMEOUT_SECONDS=45
CMA_CGM_MAX_RETRIES=2
CMA_CGM_RETRY_DELAY_SECONDS=2

# MSC adapter config (Playwright-first)
# Recommended install once:
#   pip install -e ".[browser]"
#   playwright install chrome
# Use a real browser session for tracking (default true)
MSC_USE_PLAYWRIGHT=true
# When true, do not fall back to generic HTTP mode if Playwright fails
MSC_PLAYWRIGHT_REQUIRED=false
MSC_PLAYWRIGHT_HEADLESS=true
MSC_PLAYWRIGHT_TIMEOUT_SECONDS=90
MSC_PLAYWRIGHT_REQUEST_DELAY_SECONDS=0.5
MSC_PLAYWRIGHT_BROWSER=chromium
MSC_PLAYWRIGHT_CHANNEL=chrome
MSC_PLAYWRIGHT_LOCALE=en-US
MSC_PLAYWRIGHT_USER_AGENT=
MSC_PLAYWRIGHT_TRACKING_URL=https://www.msc.com/en/track-a-shipment
MSC_PLAYWRIGHT_API_ENDPOINT=https://www.msc.com/api/feature/tools/TrackingInfo

# MSC generic fallback config (used when MSC_USE_PLAYWRIGHT=false
# or if Playwright fails and MSC_PLAYWRIGHT_REQUIRED=false)
MSC_TRACKING_URL_TEMPLATE=
MSC_TRACKING_API_URL=
MSC_API_KEY=
MSC_API_KEY_HEADER=X-API-Key
MSC_REF_PARAM=reference
MSC_TYPE_PARAM=referenceType
MSC_BOOKING_TYPE_CODE=booking
MSC_CONTAINER_TYPE_CODE=container
MSC_TIMEOUT_SECONDS=45
MSC_MAX_RETRIES=2
MSC_RETRY_DELAY_SECONDS=2

# PIL adapter config (generic)
PIL_TRACKING_URL_TEMPLATE=
PIL_TRACKING_API_URL=
PIL_API_KEY=
PIL_API_KEY_HEADER=X-API-Key
PIL_REF_PARAM=reference
PIL_TYPE_PARAM=referenceType
PIL_BOOKING_TYPE_CODE=booking
PIL_CONTAINER_TYPE_CODE=container
PIL_TIMEOUT_SECONDS=45
PIL_MAX_RETRIES=2
PIL_RETRY_DELAY_SECONDS=2

# Evergreen adapter config (generic)
EVERGREEN_TRACKING_URL_TEMPLATE=
EVERGREEN_TRACKING_API_URL=
EVERGREEN_API_KEY=
EVERGREEN_API_KEY_HEADER=X-API-Key
EVERGREEN_REF_PARAM=reference
EVERGREEN_TYPE_PARAM=referenceType
EVERGREEN_BOOKING_TYPE_CODE=booking
EVERGREEN_CONTAINER_TYPE_CODE=container
EVERGREEN_TIMEOUT_SECONDS=45
EVERGREEN_MAX_RETRIES=2
EVERGREEN_RETRY_DELAY_SECONDS=2

# Wan Hai adapter config
# Wan Hai is protected by anti-bot controls, so browser mode is recommended.
WAN_HAI_USE_PLAYWRIGHT=true
WAN_HAI_PLAYWRIGHT_REQUIRED=false
WAN_HAI_PLAYWRIGHT_HEADLESS=false
WAN_HAI_PLAYWRIGHT_BROWSER=chromium
WAN_HAI_PLAYWRIGHT_CHANNEL=chrome
WAN_HAI_PLAYWRIGHT_LOCALE=
WAN_HAI_PLAYWRIGHT_TRACKING_URL=https://vip.wanhai.com/views/cargo_track_v2/tracking_query.xhtml
WAN_HAI_PLAYWRIGHT_TIMEOUT_SECONDS=90
WAN_HAI_PLAYWRIGHT_REQUEST_DELAY_SECONDS=8
WAN_HAI_PLAYWRIGHT_USER_AGENT=
# Generic fallback settings
WAN_HAI_TRACKING_URL_TEMPLATE=
WAN_HAI_TRACKING_API_URL=
WAN_HAI_API_KEY=
WAN_HAI_API_KEY_HEADER=X-API-Key
WAN_HAI_REF_PARAM=reference
WAN_HAI_TYPE_PARAM=referenceType
WAN_HAI_BOOKING_TYPE_CODE=booking
WAN_HAI_CONTAINER_TYPE_CODE=container
WAN_HAI_TIMEOUT_SECONDS=45
WAN_HAI_MAX_RETRIES=2
WAN_HAI_RETRY_DELAY_SECONDS=2

# OOCL adapter config (generic)
OOCL_TRACKING_URL_TEMPLATE=
OOCL_TRACKING_API_URL=
OOCL_API_KEY=
OOCL_API_KEY_HEADER=X-API-Key
OOCL_REF_PARAM=reference
OOCL_TYPE_PARAM=referenceType
OOCL_BOOKING_TYPE_CODE=booking
OOCL_CONTAINER_TYPE_CODE=container
OOCL_TIMEOUT_SECONDS=45
OOCL_MAX_RETRIES=2
OOCL_RETRY_DELAY_SECONDS=2

# Hapag-Lloyd adapter config
# Option A (website/API page with JSON or embedded JSON): use {reference} and optional {type}
HAPAG_TRACKING_URL_TEMPLATE=
# Option B (API endpoint, DCSA Track & Trace)
HAPAG_TRACKING_API_URL=https://api.hlag.com/hlag/external/v2/events/
HAPAG_API_KEY=
HAPAG_API_KEY_HEADER=X-API-Key
# Optional client credential headers (common on API gateway products)
HAPAG_CLIENT_ID=
HAPAG_CLIENT_SECRET=
HAPAG_CLIENT_ID_HEADER=X-IBM-Client-Id
HAPAG_CLIENT_SECRET_HEADER=X-IBM-Client-Secret
# DCSA query keys
HAPAG_EQUIPMENT_REF_PARAM=equipmentReference
HAPAG_BOOKING_REF_PARAM=carrierBookingReference
HAPAG_TRANSPORT_DOCUMENT_REF_PARAM=transportDocumentReference
# Optional fallback keys for non-DCSA endpoint variants
HAPAG_REF_PARAM=reference
HAPAG_TYPE_PARAM=referenceType
HAPAG_BOOKING_TYPE_CODE=booking
HAPAG_CONTAINER_TYPE_CODE=container
# Optional auth modes
HAPAG_BEARER_TOKEN=
HAPAG_OAUTH_TOKEN_URL=
HAPAG_OAUTH_CLIENT_ID=
HAPAG_OAUTH_CLIENT_SECRET=
HAPAG_OAUTH_SCOPE=
# Page used in ClickUp comments for manual cross-reference
HAPAG_TRACKING_PAGE_URL_TEMPLATE=https://www.hapag-lloyd.com/en/online-business/track/track-by-container-solution.html?container={reference}
HAPAG_TIMEOUT_SECONDS=60
HAPAG_MAX_RETRIES=2
HAPAG_RETRY_DELAY_SECONDS=2

# ClickUp -> iCloud Contacts sync
# Uses CLICKUP_API_TOKEN from above.
CLICKUP_CONTACTS_LIST_ID=
# Optional comma-separated list IDs for contact sync.
CLICKUP_CONTACTS_LIST_IDS=
CLICKUP_CONTACTS_INCLUDE_CLOSED=false
CLICKUP_CONTACTS_INCLUDE_ARCHIVED=false
# If true, uses ClickUp task name as full name when full-name field is missing.
CLICKUP_CONTACT_TASK_NAME_AS_FULL_NAME=true

# Contact field selectors: either ClickUp custom field ID or field name.
CLICKUP_CONTACT_CF_FULL_NAME=
CLICKUP_CONTACT_CF_FIRST_NAME=
CLICKUP_CONTACT_CF_LAST_NAME=
CLICKUP_CONTACT_CF_EMAIL=
CLICKUP_CONTACT_CF_PHONE=
CLICKUP_CONTACT_CF_COMPANY=
CLICKUP_CONTACT_CF_TITLE=
CLICKUP_CONTACT_CF_LINKEDIN=
CLICKUP_CONTACT_CF_NOTES=
# Pull ClickUp task comments into Apple contact notes.
CLICKUP_CONTACT_SYNC_TASK_COMMENTS=true
# Max comments to include per contact (0 = all).
CLICKUP_CONTACT_COMMENTS_LIMIT=20

# iCloud CardDAV auth
ICLOUD_APPLE_ID=
ICLOUD_APP_SPECIFIC_PASSWORD=
# Base CardDAV URL used for auto-discovery.
ICLOUD_CARDDAV_URL=https://contacts.icloud.com
# Optional: set this directly to skip discovery.
ICLOUD_ADDRESSBOOK_URL=
ICLOUD_TIMEOUT_SECONDS=30

# LinkedIn candidates -> ClickUp sync
# Target list where candidate tasks will be created.
CLICKUP_CANDIDATES_LIST_ID=
# Optional: assign new candidate tasks to this existing ClickUp status.
CLICKUP_CANDIDATE_TASK_STATUS=
# Optional candidate field mappings (custom field ID or exact field name where supported).
CLICKUP_CANDIDATE_CF_LINKEDIN=
CLICKUP_CANDIDATE_CF_ROLE=
CLICKUP_CANDIDATE_CF_LOCATION=
CLICKUP_CANDIDATE_CF_MATCH_SCORE=
CLICKUP_CANDIDATE_CF_SOURCE_QUERY=

# Google Custom Search API (only required for CSE mode; not needed when using --input-csv)
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ENGINE_ID=
GOOGLE_CSE_TIMEOUT_SECONDS=30

# Default candidates per job when criteria does not set max_results.
CANDIDATE_DEFAULT_MAX_RESULTS=25

# LinkedIn copilot AI draft options (optional)
OPENAI_API_KEY=
LINKEDIN_COPILOT_USE_AI_DRAFTS=false
LINKEDIN_COPILOT_OPENAI_MODEL=gpt-4.1-mini
LINKEDIN_COPILOT_OPENAI_TIMEOUT_SECONDS=45
LINKEDIN_COPILOT_OPENAI_MAX_OUTPUT_TOKENS=220
